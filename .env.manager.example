# oumigo manager environment. Copy to `.env` next to where the manager runs (or pass
# --env-file) and fill in. Your real `.env` is gitignored: never commit it.
# Variables already in the environment (shell, systemd) win over this file.
# Every oumigo manager variable starts with MG_; see docs/environmental_variables.md.
# No comments on the same line as a value: they would become part of it.

# Reusable join token workers may present. If unset, worker authentication is
# DISABLED under provider LAN (the manager warns at startup). Under provider CUSTOM
# auth stays enforced: mint per-pod tokens instead with
#   oumigo manager token create --ttl 1h --uses 1
# Generate a reusable token:
#   python -c "import secrets; print(f'oumigo-{secrets.token_urlsafe(32)}')"
MG_JOIN_TOKEN=

# Manager config file (else the search path). --config-file on the command line wins.
# MG_CONFIG_FILE=/etc/oumigo/manager.yaml

# Web console admin account (docs/console.md). Either one empty: no admin, and the
# console is view-only (closing workers needs a signed-in admin).
# Make the hash with `oumigo manager admin-password`, or use the console's
# Create Admin Account page, which writes both lines here.
# MG_ADMIN_USER=admin
# MG_ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<key>
