# oumigo worker environment. Copy to `.env` in the directory you run
# `oumigo worker run` from (or pass --env-file) and fill in. Your real `.env` is
# gitignored: never commit it. Variables already in the environment win over this file.
# Every oumigo worker variable starts with WK_; HF_* and VLLM_* belong to Hugging Face
# and vLLM. See docs/environmental_variables.md.
# No comments on the same line as a value: they would become part of it.

# Manager control-plane URL. Required for remote workers (mDNS discovery is LAN-only);
# a CUSTOM manager must be reached over https://.
# WK_MANAGER_URL=https://oumigo.example.net

# Join token from the manager operator (a minted per-pod token, or the reusable one).
# Spent at registration; the worker then uses its own node token.
# WK_JOIN_TOKEN=

# How the router reaches this worker: direct (router dials this host; LAN) or tunnel
# (this worker dials out to the manager; no inbound port needed, e.g. RunPod / Vast).
# WK_TRANSPORT=tunnel

# Trust a manager with a private (self-signed) certificate: path to its PEM.
# WK_MANAGER_CA_FILE=/path/to/manager-cert.pem

# Stable node identity on hosts whose disk is wiped on restart (e.g. a RunPod
# container disk). Any stable string; default is a UUID persisted in the state dir.
# WK_HOST_ID=

# The model this worker runs: a catalog profile id from the manager's catalog.allow
# (see docs/model-catalog.md). Unset = the fleet's default. Every start-time setting
# (context length, memory share, vLLM flags) comes from the profile on the manager.
# WK_MODEL_PROFILE=gemma-4-12B-it-qat-w4a16-ct@128k

# The GPU this worker runs on, on a machine with several: nvidia-smi's index (from 0)
# or a UUID (GPU-…); a comma-separated list for a model sharded over several GPUs.
# `--gpu-id` on the command line wins. Unset = $CUDA_VISIBLE_DEVICES, else GPU 0.
# WK_GPU_ID=1

# Weights already on this machine's disk, instead of downloading them from the Hub.
# WK_MODEL_STORAGE_LOCATION=file:///srv/models/gemma-4-12B-it-qat-w4a16-ct

# Longest wait, in seconds, for requests in progress when the worker is stopped or
# closed. Unset: the profile's agent.turn_timeout, else 120.
# WK_DRAIN_TIMEOUT=1800

# Seconds to look for a manager on the LAN (mDNS) when WK_MANAGER_URL is unset.
# WK_DISCOVER_TIMEOUT=60

# Seconds of metrics kept while reports to the manager fail; older samples are dropped.
# At least 35 (one report interval plus one sample).
# WK_METRICS_MAX_KEEPING_AGE=60

# Optional: helps with HF download rate limits (in the case model is not gated).
HF_TOKEN=

# Hugging Face cache. Point at a SHARED cache to avoid re-downloading the GBs models.
# Must be set BEFORE transformers is imported — the app loads this .env first.
# HF_HOME=~/.hf_cache

# Optional: vLLM's own cache (torch.compile / CUDA-graph artifacts, NOT model
# weights — those live under HF_HOME). Defaults to ~/.cache/vllm if unset. Point
# at a shared/persistent volume to avoid recompiling on every start.
#
# VLLM_CACHE_ROOT=~/.vllm_cache
