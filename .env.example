# Copy to `.env` and fill in. Your real `.env` is gitignored — never commit it.
# In production, supply these via systemd EnvironmentFile= or the orchestrator.


#----------------------------------------------------------------------------
# oumigo manager — development / sandbox environment.
#----------------------------------------------------------------------------

# Reusable join token workers may present. If unset, worker authentication is
# DISABLED under provider LAN (v1 dev behavior; the manager warns at startup). Under
# provider CUSTOM auth stays enforced: mint per-pod tokens instead with
#   oumigo manager token create --ttl 1h --uses 1
# Generate a reusable token:
#   python -c "import secrets; print(f'oumigo-{secrets.token_urlsafe(32)}')"
OUMIGO_MANAGER_TOKEN=

# Optional: manager config file (else the search path is used). Overridden by
# --config-file on the command line.
# OUMIGO_CONFIG_FILE=./manager.yaml


#----------------------------------------------------------------------------
# oumigo worker  — development / sandbox environment.
#----------------------------------------------------------------------------

# Manager control-plane URL. Required for remote workers (mDNS discovery is LAN-only);
# a CUSTOM manager must be reached over https://.
# OUMIGO_MANAGER_URL=https://oumigo.example.net

# Join token from the manager operator (a minted per-pod token, or the reusable one).
# Spent at registration; the worker then uses its own node token.
# OUMIGO_JOIN_TOKEN=

# How the router reaches this worker: direct (router dials this host; LAN) or tunnel
# (this worker dials out to the manager; no inbound port needed, e.g. RunPod / Vast).
# OUMIGO_TRANSPORT=tunnel

# Trust a manager with a private (self-signed) certificate: path to its PEM.
# OUMIGO_MANAGER_CA_FILE=/path/to/manager-cert.pem

# Stable node identity on hosts whose disk is wiped on restart (e.g. a RunPod
# container disk). Any stable string; default is a UUID persisted in the state dir.
# OUMIGO_HOST_ID=

# Negotiable model config: these override what the manager hands the worker. Set
# MODEL_NAME to serve a different model than the manager's node_spec (or to serve
# at all when the manager has no model configured). MAX_MODEL_LEN caps context.
# Applies to both --backend=vllm and --backend=transformer.
#
# MODEL_NAME=google/gemma-4-E2B-it
# MAX_MODEL_LEN=8192

# Optional: helps with HF download rate limits (in the case model is not gated).
HF_TOKEN=

# Hugging Face cache. Point at a SHARED cache to avoid re-downloading the GBs models.
# Must be set BEFORE transformers is imported — the app loads this .env first.
# HF_HOME=~/.hf_cache

# Optional: vLLM's own cache (torch.compile / CUDA-graph artifacts, NOT model
# weights — those live under HF_HOME). Defaults to ~/.cache/vllm if unset. Point
# at a shared/persistent volume to avoid recompiling on every start.
#
# VLLM_CACHE_ROOT=~/.vllm_cache
